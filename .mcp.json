    },
    "imagekit_api": {
      "type": "http",
      "url": "https://api-mcp.imagekit.io/mcp"
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=bzlyasfqomdvnlpjjaky&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
    },
    "google-ads": {
      "command": "/full/path/to/your/project/.venv/bin/python",
